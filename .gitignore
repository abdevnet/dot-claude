# Ignore everything by default
*

# Allow these specific files and folders
!CLAUDE.md
!agents/
!skills/
!commands/
!settings.json
!statusline.sh
!play-sound.sh
!sounds/
!hooks/
!RTK.md
!jira-isfs.md


# Allow contents inside those folders
!agents/**
!skills/**
!commands/**
!sounds/**
!hooks/**
# Keep the .gitignore file itself
!.gitignore

# Ignore system / editor junk inside allowed folders
# macOS - always ignore at any depth
.DS_Store
**/.DS_Store

# VS Code
.vscode/

# JetBrains IDEs
.idea/

# Logs and temp files
*.log
tmp/
*.tmp
*.swp

# Claude-managed skill folders (trash bin and claude.ai sync cache)
skills/.trash/
skills/synced/

# Python bytecode
__pycache__/
*.pyc

