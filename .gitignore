!sounds/**
# Keep the .gitignore file itself
!.gitignore

# Ignore system / editor junk inside allowed folders
# macOS
.DS_Store

# VS Code
.vscode/

# JetBrains IDEs
.idea/

# Logs and temp files
*.log
tmp/
*.tmp
*.swp
