{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_evaluate",
      "Bash(claude config list)",
      "Bash(claude mcp list)",
      "mcp__playwright__browser_network_requests",
      "Bash(claude plugin list:*)",
      "Bash(claude plugin marketplace:*)",
      "Bash(claude plugin --help:*)",
      "WebFetch(domain:github.com)",
      "Bash(claude skill:*)",
      "WebFetch(domain:devblogs.microsoft.com)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "Bash(cat:*)",
      "Bash(dotnet run:*)",
      "Bash(curl:*)",
      "Bash(dotnet-script:*)",
      "WebFetch(domain:gist.github.com)",
      "Bash(chmod:*)",
      "Bash(docker run:*)",
      "Bash(./setup-monitoring.sh)",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_take_screenshot",
      "Bash(docker-compose logs:*)",
      "Bash(python3:*)",
      "Bash(docker-compose restart:*)",
      "Bash(docker logs:*)",
      "Bash(docker exec:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker-compose ps:*)",
      "WebFetch(domain:agents.md)",
      "Bash(pdftotext:*)",
      "Bash(echo:*)",
      "Bash(starship:*)",
      "Bash(source:*)",
      "Bash(ls:*)",
      "Bash(du -ch:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset HEAD:*)",
      "Bash(cp:*)",
      "Bash(rm:*)",
      "Bash(defaults read:*)",
      "Bash(plutil:*)",
      "Bash(ps:*)",
      "Bash(xargs:*)",
      "Bash(ghostty:*)",
      "Bash(xcrun simctl runtime delete:*)",
      "Bash(xcrun simctl:*)",
      "Bash(du:*)",
      "Bash(colima list:*)",
      "Bash(colima start:*)",
      "Bash(docker:*)",
      "Bash(git remote:*)",
      "Bash(pwd)",
      "Bash(pwd:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/clipboard-paste.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/play-sound.sh permission"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/play-sound.sh idle"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": false,
    "commit-commands@claude-code-plugins": false,
    "omnisharp@claude-code-lsps": false,
    "ralph-wiggum@claude-code-plugins": false,
    "csharp-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "skipAutoPermissionPrompt": true
}
